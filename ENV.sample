# Zkopíruj do .env.local:  cp ENV.sample .env.local

# Neon Postgres connection string (pooled, z Vercel → Storage → Neon)
DATABASE_URL=

# Podpis přihlašovacího cookie. Vygeneruj:  openssl rand -base64 32
AUTH_SECRET=

# Zvací kód pro registraci — bez něj se nikdo nezaregistruje.
# Řekni ho ženě, ať si založí vlastní účet.
INVITE_CODE=
